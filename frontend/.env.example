# Copia este ficheiro para .env e preenche com os valores reais.
# IMPORTANTE: usa a chave "anon" (pública, protegida por RLS), nunca a
# "service_role" key usada pelo pipeline Python — essa bypassa RLS e
# nunca deve ir para código que corre no browser.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
